{
  "stdioBinary": {
    "mcpServers": {
      "abuseipdb": {
        "command": "/absolute/path/to/abuseipdb-mcp",
        "env": {
          "ABUSEIPDB_API_KEY": "replace-with-your-api-v2-key"
        }
      }
    }
  },
  "stdioDocker": {
    "mcpServers": {
      "abuseipdb": {
        "command": "docker",
        "args": [
          "run",
          "--rm",
          "-i",
          "-e",
          "ABUSEIPDB_API_KEY",
          "abuseipdb-mcp:local"
        ],
        "env": {
          "ABUSEIPDB_API_KEY": "replace-with-your-api-v2-key"
        }
      }
    }
  },
  "streamableHTTP": {
    "mcpServers": {
      "abuseipdb": {
        "url": "http://127.0.0.1:8080/mcp",
        "headers": {
          "Authorization": "Bearer replace-with-your-mcp-token"
        }
      }
    }
  }
}
